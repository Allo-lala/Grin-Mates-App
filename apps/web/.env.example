# Copy this file to .env and fill in your own values

# MetaMask WalletConnect Configuration
WALLET_CONNECT_PROJECT_ID=your_wallet_connect_project_id_here

# Backend API Configuration
API_BASE_URL=http://localhost:3000/api
API_TIMEOUT_SECONDS=30

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/grinmates_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=grinmates_db
DB_USER=grinmates_user
DB_PASSWORD=your_secure_password_here

# Blockchain Configuration
CELO_RPC_URL=https://forno.celo.org
CELO_NETWORK=mainnet

# File Upload Configuration
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf

# Security
JWT_SECRET=your_jwt_secret_key_here
ENCRYPTION_KEY=your_encryption_key_here
# SESSION_TIMEOUT_MINUTES=60

# Self Protocol Configuration
# Required: Application name displayed in Self Protocol mobile app
NEXT_PUBLIC_SELF_APP_NAME="Grin Mates"

# Required: Unique scope seed for your Self Protocol integration
# This is a simple string identifier for your app (e.g., "grin-mates", "my-app")
NEXT_PUBLIC_SELF_SCOPE_SEED="grin-mates"

# Required: Self Protocol API endpoint URL
# For local development: http://localhost:3000/api/kyc/verify
# For production: Use ngrok or your deployed URL (e.g., https://yourdomain.com/api/kyc/verify)
NEXT_PUBLIC_SELF_ENDPOINT=http://localhost:3000/api/kyc/verify

# Required: Logo URL displayed in Self Protocol mobile app during verification
NEXT_PUBLIC_SELF_LOGO_URL=https://i.postimg.cc/mrmVf9hm/self.png

# Optional: Blockchain endpoint type for verification storage
# 
# AUTOMATIC DETECTION (Recommended):
# If not set, the application automatically determines the correct endpoint:
#   - Local Development: 'staging_celo' (Celo Testnet - Alfajores)
#   - Vercel Preview: 'staging_celo' (Celo Testnet - Alfajores)
#   - Vercel Production: 'celo' (Celo Mainnet)
#
# MANUAL OVERRIDE (Optional):
# Set this variable to override automatic detection
# Valid values:
#   - 'celo': Mainnet onchain verification (production)
#   - 'staging_celo': Testnet onchain verification (development/testing)
#   - 'https': Mainnet offchain verification
#   - 'staging_https': Testnet offchain verification
#
# Example: Force testnet in all environments
# NEXT_PUBLIC_SELF_ENDPOINT_TYPE=staging_celo
#
# Example: Force mainnet for testing
# NEXT_PUBLIC_SELF_ENDPOINT_TYPE=celo

# Optional: Vercel environment (automatically set by Vercel)
# Used for automatic endpoint type detection
# Values: 'production' | 'preview' | 'development'
# Do not set manually - Vercel sets this automatically
# NEXT_PUBLIC_VERCEL_ENV=production

# Performance & Development
# Set to 'true' to analyze bundle size during build
# ANALYZE=false