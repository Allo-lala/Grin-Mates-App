# API
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Celo
NEXT_PUBLIC_CELO_NETWORK=celo_sepolia

# Smart Contract Address (ProofOfHuman on Celo Sepolia)
NEXT_PUBLIC_CONTRACT_ADDRESS=0xdCb5C103D8bFd00b3c7b5a131C58a3EA14e1668b

NEXT_PUBLIC_PRIVY_APP_ID=cmi3mhdyb006llb0c01eo8qfd

# Self Protocol Configuration
NEXT_PUBLIC_SELF_APP_NAME="Grin Mates"
NEXT_PUBLIC_SELF_SCOPE_SEED="grin-mates"
# For on-chain verification, this should be the deployed contract address (not an API endpoint)
NEXT_PUBLIC_SELF_ENDPOINT=0xdCb5C103D8bFd00b3c7b5a131C58a3EA14e1668b

# Or use localhost for local testing: http://localhost:3001/api/kyc/verify
NEXT_PUBLIC_SELF_LOGO_URL=https://i.postimg.cc/mrmVf9hm/self.png

# Endpoint Type: Using on-chain verification with deployed smart contract
# - staging_https: Off-chain verification for testnet
# - https: Off-chain verification for mainnet
# - staging_celo: On-chain verification for testnet (requires deployed contract)
# - celo: On-chain verification for mainnet (requires deployed contract)
NEXT_PUBLIC_SELF_ENDPOINT_TYPE=staging_celo 