# ============================================================================
# FOUNDRY DEPLOYMENT CONFIGURATION
# ============================================================================
# ⚠️  NEVER commit this file with real values to version control
# Copy this file to .env and fill in your actual values
# ============================================================================

# ----------------------------------------------------------------------------
# REQUIRED: Deployment Account Private Key
# ----------------------------------------------------------------------------
# The private key of the account that will deploy the contracts
# IMPORTANT: DO NOT USE A KEY THAT HOLDS REAL FUNDS ON MAINNET
# For testnet deployments, use a dedicated testnet-only account
# Format: 64-character hex string (without 0x prefix)
# Example: abc123def456...
PRIVATE_KEY=your_private_key_here

# ----------------------------------------------------------------------------
# REQUIRED: Celoscan API Key
# ----------------------------------------------------------------------------
# API key for verifying contracts on Celoscan block explorer
# Get your API key at: https://celoscan.io/myapikey
# This is used by Foundry's verify-contract command
# The same key works for Alfajores testnet and Celo mainnet
CELOSCAN_API_KEY=4AM7JWZIW9D4W7SA3GRSURXRM6PEXSMTF8

# ----------------------------------------------------------------------------
# REQUIRED: Self Protocol Scope Seed
# ----------------------------------------------------------------------------
# A unique identifier used to create the verification scope for your contract
# This should be a unique string that identifies your application
# Example: "grin-mates-production" or "my-app-v1"
# IMPORTANT: Keep this consistent across deployments to maintain the same scope
SCOPE_SEED=grin-mates

IDENTITY_VERIFICATION_HUB_ADDRESS= 

# ----------------------------------------------------------------------------
# REQUIRED: RPC Endpoints
# ----------------------------------------------------------------------------
# RPC URLs for connecting to Celo networks
# These are used by Foundry for deployment and contract interaction

# Celo Mainnet RPC URL (Chain ID: 42220)
CELO_RPC_URL=https://forno.celo.org

# Celo Alfajores Testnet RPC URL (Chain ID: 44787)
# Use this for testing before mainnet deployment
ALFAJORES_RPC_URL=https://alfajores-forno.celo-testnet.org

# Celo Sepolia Testnet RPC URL (Chain ID: 11142220)
# Alternative testnet for development
SEPOLIA_RPC_URL=https://forno.celo-sepolia.celo-testnet.org



# Users, after connecting their wallets ( only wallets supported by Privy), are redirected to scan a Self QR code to prove being human before they can proceed to the home screen of the Grin Mates Application. Users scan the QR through the Self Ap on both IOS and Android 