{
  "name": "foundry-contracts",
  "version": "1.0.0",
  "description": "Smart contracts for Grin-Mates using Foundry",
  "main": "index.js",
  "scripts": {
    "build": "forge build",
    "test": "forge test",
    "test:verbose": "forge test -vvv",
    "deploy:alfajores": "forge script script/DeployAlfajores.s.sol:DeployAlfajores --rpc-url alfajores --broadcast --verify",
    "deploy:sepolia": "forge script script/DeploySepolia.s.sol:DeploySepolia --rpc-url sepolia --broadcast --verify",
    "deploy:celo": "forge script script/DeployCelo.s.sol:DeployCelo --rpc-url celo --broadcast --verify",
    "verify:alfajores": "forge verify-contract --chain alfajores --etherscan-api-key $CELOSCAN_API_KEY --compiler-version v0.8.28",
    "verify:sepolia": "forge verify-contract --chain sepolia --etherscan-api-key $CELOSCAN_API_KEY --compiler-version v0.8.28",
    "verify:celo": "forge verify-contract --chain celo --etherscan-api-key $CELOSCAN_API_KEY --compiler-version v0.8.28"
  },
  "keywords": [
    "foundry",
    "ethereum",
    "celo",
    "smart-contracts",
    "solidity"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {},
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.0"
  }
}
